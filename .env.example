PORT=5000
APP_URL=http://localhost:5000

# ==========================================
# UpCloud Cloud Provider API 1.3 Configuration
# Docs: https://developers.upcloud.com/api/1.3
# ==========================================
# Option A: API Bearer Token (Recommended)
UPCLOUD_API_TOKEN=
# Multi-Token Failover Support:
# UPCLOUD_API_TOKEN_PRIMARY=
# UPCLOUD_API_TOKEN_BACKUP=

# Option B: Subaccount Basic Authentication
UPCLOUD_USERNAME=
UPCLOUD_PASSWORD=

# ==========================================
# BuatQRIS Payment Gateway Open API Configuration
# Dashboard: https://app.buatqris.site/dasbort
# Docs: konfigurasi-open-api.txt
# ==========================================
BUATQRIS_ACCOUNT_ID=
BUATQRIS_SECRET_TOKEN=
BUATQRIS_SIGNING_SECRET=
BUATQRIS_METHOD=qris_two
BUATQRIS_FEE_BY=user
IS_SANDBOX=true
